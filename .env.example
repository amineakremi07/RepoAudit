# =====================================================================
# RepoAudit - environment template
# Copy to `.env` at the repo root (never commit `.env`).
# All values below are PLACEHOLDERS. No real secrets belong in this file.
# =====================================================================

# ---------- Core infrastructure ----------
POSTGRES_USER=repoaudit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=repoaudit
DATABASE_URL=postgres://repoaudit:change-me-local-only@localhost:5432/repoaudit
REDIS_URL=redis://localhost:6379

# ---------- API service (services/api) ----------
API_PORT=4000
# 127.0.0.1 until auth lands (Sprint 4)
API_HOST=127.0.0.1
# memory | bullmq  (memory = API-only dev, no scanner handoff; bullmq = real handoff via Redis)
JOB_QUEUE_DRIVER=memory

# ---------- Git provider integration ----------
# Webhook secrets: generate with `openssl rand -hex 32`
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=
# Fine-grained, READ-ONLY token (Contents: read, Metadata: read). Never a token with write/admin scopes.
GITHUB_READONLY_TOKEN=
# GitLab: project/group access token with `read_repository` scope only.
GITLAB_READONLY_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# ---------- Scanner service (services/scanner) ----------
SCANNER_WORKSPACE_ROOT=./.workspaces
SCANNER_TIMEOUT_SECONDS=600
SCANNER_MAX_REPO_MB=500
SCANNER_CONCURRENCY=2
# Analyzer images - pin by digest (image@sha256:...) before beta
SEMGREP_IMAGE=semgrep/semgrep
OSV_API_URL=https://api.osv.dev/v1
# Host dir of vendored Semgrep rules (mounted read-only; sandbox has no network). Empty = SAST skipped.
SEMGREP_RULES_DIR=

# ---------- AI advisor (services/ai-advisor) ----------
AI_ADVISOR_PORT=4100
# mock | anthropic | openai-compatible
AI_PROVIDER=mock
# e.g. a current Claude model id for anthropic; required unless AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
# Only for openai-compatible providers (e.g. a self-hosted gateway)
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=4096

# ---------- Web dashboard (apps/web) ----------
# Server-side only (pages are Server Components); never exposed to the browser bundle
API_URL=http://localhost:4000
